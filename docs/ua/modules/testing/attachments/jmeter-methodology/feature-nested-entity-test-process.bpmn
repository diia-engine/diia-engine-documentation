    <bpmn:scriptTask id="Activity_0qmbuk9" name="Підготовка даних для запису (transient var)" scriptFormat="groovy">
      <bpmn:incoming>Flow_0qjemi2</bpmn:incoming>
      <bpmn:outgoing>Flow_0jy1ssm</bpmn:outgoing>
      <bpmn:script>println "begining Activity_0qmbuk9"
println "tx : " + tx
println "order : " + order

def personProfileId = order.prop('personProfileId').value()
def personEduProfileId = tx.prop('personEduProfileId').value()
println "personProfileId : " + personProfileId
println "personEduProfileId : " + personEduProfileId

def personEduProfile =
['personProfileId':personProfileId,
'personEduProfileId':personEduProfileId]

def formData = submission('signDataActivity').formData
println "orderFormData : " + formData

def orders = [:]
orders['ordersType'] = formData.prop('order_type').value()
orders['ordersNumber'] = formData.prop('order_number').value()
orders['ordersDate'] = formData.prop('order_date').value() + "T13:17:10.952Z"
orders['personProfileId'] = personProfileId
orders['ordersId'] = tx.prop('ordersId').value()

 def listFileObj = []
        def fileObj = [:]
        fileObj.id = formData.prop('files').elements().get(0).prop('id').stringValue()
        fileObj.checksum = formData.prop('files').elements().get(0).prop('checksum').stringValue()
        listFileObj &lt;&lt; fileObj

orders['files'] = listFileObj

def cephData = ['personEduProfile':personEduProfile,'orders':orders,
'transactionId':tx.prop('transactionId').value()]

def createComplexPayload = S(cephData, 'application/json')
println "createComplexPayload : " + createComplexPayload

set_transient_variable('createComplexPayload', createComplexPayload)</bpmn:script>
    </bpmn:scriptTask>
