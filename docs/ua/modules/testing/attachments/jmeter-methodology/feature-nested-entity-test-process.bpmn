    <bpmn:scriptTask id="Activity_1fbwjwd" name="скрипт для прездаполнения на форму" scriptFormat="groovy">
      <bpmn:incoming>Flow_0w4cisl</bpmn:incoming>
      <bpmn:outgoing>Flow_08xq8gk</bpmn:outgoing>
      <bpmn:script>execution.setVariable("tx", txResponse.responseBody)
execution.setVariable("order", ordResponse.responseBody)

data=[:]
data['order_type'] = order.prop('ordersType').value()
data['order_number'] = order.prop('ordersNumber').value()
data['order_date'] = order.prop('ordersDate').value()

def listFileObj = []
def fileObj = [:]
fileObj.id = order.prop('files').elements().get(0).prop('id').stringValue()
fileObj.checksum = order.prop('files').elements().get(0).prop('checksum').stringValue()
listFileObj &lt;&lt; fileObj

data['files'] = listFileObj


execution.setVariable('payload', S(data, 'application/json'))
println "payload : " + payload</bpmn:script>
    </bpmn:scriptTask>
