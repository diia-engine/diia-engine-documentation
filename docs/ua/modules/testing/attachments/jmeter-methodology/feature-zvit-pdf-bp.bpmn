<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:data="http://data.sh4.red" id="Definitions_0xse54i" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.25.0">
  <bpmn:collaboration id="Collaboration_19gf5r6">
    <bpmn:participant id="Participant_0myrytm" name="Отримання витягу" processRef="feature-zvit-pdf-bp" />
    <bpmn:textAnnotation id="TextAnnotation_0vpxp0b">
      <bpmn:text>Перевірка стану за ${excerptIdentifier}</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1xbs3jp">
      <bpmn:text>SYS_VAR_PROCESS_EXCERPT_ID = ${excerptIdentifier}</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1n1i54x">
      <bpmn:text>SYS_VAR_PROCESS_COMPLETION_RESULT</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1xd5aus" sourceRef="checkExcerptStatusActivity" targetRef="TextAnnotation_0vpxp0b" />
    <bpmn:association id="Association_0v5wcci" sourceRef="Activity_0pzntoq" targetRef="TextAnnotation_1xbs3jp" />
    <bpmn:association id="Association_0rl80si" sourceRef="Activity_123i7re" targetRef="TextAnnotation_1n1i54x" />
  </bpmn:collaboration>
  <bpmn:process id="feature-zvit-pdf-bp" name="Формування витягу по факторам в форматі pdf" isExecutable="true">
    <bpmn:serviceTask id="Activity_0fyl8n0" name="Пошук даних про фактори" camunda:modelerTemplate="dataFactoryConnectorSearchDelegate" camunda:delegateExpression="${dataFactoryConnectorSearchDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="resource">factor-all</camunda:inputParameter>
          <camunda:inputParameter name="x_access_token">${initiator().accessToken}</camunda:inputParameter>
          <camunda:outputParameter name="factorResponse">${ response }</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ow8a4x</bpmn:incoming>
      <bpmn:outgoing>Flow_18bu8xr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_0fhm7i5" name="Підготовка даних для показу" scriptFormat="groovy">
      <bpmn:incoming>Flow_18bu8xr</bpmn:incoming>
      <bpmn:outgoing>Flow_1h0misw</bpmn:outgoing>
      <bpmn:script>def factorResponseBody = factorResponse.responseBody
def payload = S([:], 'application/json')
payload.prop('factorGrid', factorResponseBody)
set_transient_variable('payload', payload)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_0t6qcez">
      <bpmn:incoming>Flow_008xayw</bpmn:incoming>
      <bpmn:incoming>Flow_1h0misw</bpmn:incoming>
      <bpmn:outgoing>Flow_01oud2l</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="StartEvent_1" name="початок" camunda:initiator="initiator">
      <bpmn:outgoing>Flow_1ow8a4x</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="factorDataZvitForm" name="Відобразити дані про фактори" camunda:modelerTemplate="formUserTaskTemplate" camunda:formKey="feature-read-factor-data-zvit" camunda:assignee="${initiator}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="userTaskInputFormDataPrepopulate">${payload}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:properties>
          <camunda:property name="formVariables" value="" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01oud2l</bpmn:incoming>
      <bpmn:outgoing>Flow_01koqrc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_1wqke0e" name="Підготовка даних для запису (transient var)" scriptFormat="groovy">
      <bpmn:incoming>Flow_01koqrc</bpmn:incoming>
      <bpmn:outgoing>Flow_0meiy4a</bpmn:outgoing>
      <bpmn:script>def factorFormData = submission('factorDataZvitForm').formData
def factorsData = []

def factorGrid = factorFormData.prop('factorGrid').elements()
factorGrid.eachWithIndex { element, index -&gt;
  def factorName = element.prop('name').value()
  def item = [:]
  item[index as String] = index
  item['factorName'] = factorName
  factorsData &lt;&lt; item
}

def factors = ["factors":factorsData]
def request = S([:], 'application/json')
request.prop('recordId', null as String)
request.prop('excerptType', 'feature-factors-excerpt')
request.prop('excerptInputData', S(factors, 'application/json'))
request.prop('requiresSystemSignature', true)

execution.removeVariable('payload')
set_transient_variable('payload', request)
set_transient_variable('factors', factors)

println "factors=$factors"</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_011v7iy" name="Запит про витяг" camunda:modelerTemplate="excerptConnectorGenerateDelegate" camunda:delegateExpression="${excerptConnectorGenerateDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="excerptType">feature-factors-excerpt</camunda:inputParameter>
          <camunda:inputParameter name="x_access_token">${initiator().accessToken}</camunda:inputParameter>
          <camunda:inputParameter name="x_digital_signature_ceph_key">${sign_submission('factorDataZvitForm').signatureDocumentId}</camunda:inputParameter>
          <camunda:inputParameter name="x_digital_signature_derived_ceph_key">${system_signature_ceph_key}</camunda:inputParameter>
          <camunda:inputParameter name="requiresSystemSignature">true</camunda:inputParameter>
          <camunda:inputParameter name="excerptInputData">${factors}</camunda:inputParameter>
          <camunda:outputParameter name="response">${ response }</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0gfht8f</bpmn:incoming>
      <bpmn:outgoing>Flow_152j74l</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_1s7pxkn" name="Зберегти id витягу" scriptFormat="groovy" camunda:resultVariable="excerptIdentifier" data:scriptResultVariableType="STRING">
      <bpmn:incoming>Flow_152j74l</bpmn:incoming>
      <bpmn:outgoing>Flow_1n478d9</bpmn:outgoing>
      <bpmn:script>response.responseBody.prop('excerptIdentifier').value()</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:callActivity id="checkExcerptStatusActivity" name="Перевірка статусу генерації витягу" camunda:modelerTemplate="checkExcerptStatusCallActivity" camunda:asyncBefore="true" calledElement="feature-check-excerpt-status">
      <bpmn:extensionElements>
        <camunda:in sourceExpression="${excerptIdentifier}" target="excerptIdentifier" />
        <camunda:out source="excerptStatus" target="excerptStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n478d9</bpmn:incoming>
      <bpmn:outgoing>Flow_1t85m9x</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_0atdksx" name="Генерації завершено успішно?">
      <bpmn:incoming>Flow_1t85m9x</bpmn:incoming>
      <bpmn:outgoing>Flow_193txlw</bpmn:outgoing>
      <bpmn:outgoing>Flow_1bz7frf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0pzntoq" name="Зберегти ідентифікатор згенерованого витягу у системну БП" camunda:modelerTemplate="defineProcessExcerptIdDelegate" camunda:delegateExpression="${defineProcessExcerptIdDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="excerptId">${excerptIdentifier}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_193txlw</bpmn:incoming>
      <bpmn:outgoing>Flow_1agspbj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_015k477" name="Результат виконання &#34;Витяг не сформовано&#34;" camunda:modelerTemplate="defineBusinessProcessStatusDelegate" camunda:delegateExpression="${defineBusinessProcessStatusDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="status">Витяг не сформовано</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18k5l37</bpmn:incoming>
      <bpmn:outgoing>Flow_0fvkk0u</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0hxoms4">
      <bpmn:incoming>Flow_0nz14lw</bpmn:incoming>
      <bpmn:incoming>Flow_1bz7frf</bpmn:incoming>
