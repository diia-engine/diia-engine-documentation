    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_114kwb8" name="Витяг не сформовано">
      <bpmn:incoming>Flow_0fvkk0u</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_123i7re" name="Результат виконання &#34;Витяг сформовано&#34;" camunda:modelerTemplate="defineBusinessProcessStatusDelegate" camunda:delegateExpression="${defineBusinessProcessStatusDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="status">Витяг сформовано</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1agspbj</bpmn:incoming>
      <bpmn:outgoing>Flow_1cgv5th</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_07t619e" name="Витяг сформовано">
      <bpmn:incoming>Flow_1cgv5th</bpmn:incoming>
    </bpmn:endEvent>
