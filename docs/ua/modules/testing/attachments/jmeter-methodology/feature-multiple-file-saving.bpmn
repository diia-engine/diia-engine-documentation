<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:rrm="http://registry-regulation-management" exporter="Camunda Modeler" exporterVersion="4.6.0" id="Definitions_1e1q2gw" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0" rrm:created="2026-05-14T13:27:06.000Z" rrm:modified="2026-05-15T09:08:22.277Z" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0jc9zeu">
    <bpmn:participant id="Participant_0vwofvm" name="Завантаження масиву файлів" processRef="feature-multiple-file-saving"/>
  </bpmn:collaboration>
  <bpmn:process id="feature-multiple-file-saving" isExecutable="true" name="Завантаження масиву файлів">
    <bpmn:startEvent camunda:initiator="initiator" id="start_event" name="Start">
      <bpmn:outgoing>Flow_07qx4yi</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask camunda:assignee="${initiator}" camunda:formKey="feature-sign-object-file" camunda:modelerTemplate="officerSignTaskTemplate" id="signLabActivity" name="Підписати дані про об'єкт">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="userTaskInputFormDataPrepopulate">${submission('addLabActivity').formData}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:properties>
          <camunda:property name="formVariables" value=""/>
          <camunda:property name="eSign" value="true"/>
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09h1y3l</bpmn:incoming>
      <bpmn:outgoing>Flow_1hso8od</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask camunda:delegateExpression="${dataFactoryConnectorCreateDelegate}" camunda:modelerTemplate="dataFactoryConnectorCreateDelegate" id="Activity_14ggrc7" name="Зберегти дані в БД">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="x_access_token">${completer('signLabActivity').accessToken}</camunda:inputParameter>
          <camunda:inputParameter name="x_digital_signature_ceph_key">${sign_submission('signLabActivity').signatureDocumentId}</camunda:inputParameter>
          <camunda:inputParameter name="payload">${payload}</camunda:inputParameter>
          <camunda:inputParameter name="x_digital_signature_derived_ceph_key">${system_signature_key}</camunda:inputParameter>
          <camunda:inputParameter name="resource">laboratory-with-multiple-file</camunda:inputParameter>
          <camunda:outputParameter name="createLabResponse">${ response }</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ymqnwy</bpmn:incoming>
      <bpmn:outgoing>Flow_1m59zjs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_0h2k8t6" name="Підготовка даних для запису (transient var)" scriptFormat="groovy">
      <bpmn:incoming>Flow_1hso8od</bpmn:incoming>
      <bpmn:outgoing>Flow_0cg31eq</bpmn:outgoing>
      <bpmn:script>set_transient_variable('payload', submission('signLabActivity').formData)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask camunda:assignee="${initiator}" camunda:formKey="feature-add-object-file" camunda:modelerTemplate="formUserTaskTemplate" id="addLabActivity" name="Внести дані про об'єкт">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="userTaskInputFormDataPrepopulate"/>
        </camunda:inputOutput>
        <camunda:properties>
          <camunda:property name="formVariables" value=""/>
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07qx4yi</bpmn:incoming>
      <bpmn:outgoing>Flow_09h1y3l</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_07qx4yi" sourceRef="start_event" targetRef="addLabActivity"/>
    <bpmn:sequenceFlow id="Flow_1hso8od" sourceRef="signLabActivity" targetRef="Activity_0h2k8t6"/>
    <bpmn:sequenceFlow id="Flow_0cg31eq" sourceRef="Activity_0h2k8t6" targetRef="Activity_0v47s4a"/>
    <bpmn:sequenceFlow id="Flow_09h1y3l" sourceRef="addLabActivity" targetRef="signLabActivity"/>
    <bpmn:sequenceFlow id="Flow_1ymqnwy" sourceRef="Activity_0v47s4a" targetRef="Activity_14ggrc7"/>
    <bpmn:serviceTask camunda:delegateExpression="${digitalSystemSignatureDelegate}" camunda:modelerTemplate="digitalSystemSignatureDelegate" id="Activity_0v47s4a" name="Підписати дані системним ключем">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="x_access_token">${completer('signLabActivity').accessToken}</camunda:inputParameter>
          <camunda:inputParameter name="payload">${payload}</camunda:inputParameter>
          <camunda:outputParameter name="system_signature_key">${ system_signature_storage_key }</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cg31eq</bpmn:incoming>
      <bpmn:outgoing>Flow_1ymqnwy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_04tfs55" name="end">
      <bpmn:incoming>Flow_1m59zjs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1m59zjs" sourceRef="Activity_14ggrc7" targetRef="Event_04tfs55"/>
  </bpmn:process>
