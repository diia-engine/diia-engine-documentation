      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="userTaskInputFormDataPrepopulate" />
        </camunda:inputOutput>
        <camunda:properties>
          <camunda:property name="formVariables" value="" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bayal3</bpmn:incoming>
