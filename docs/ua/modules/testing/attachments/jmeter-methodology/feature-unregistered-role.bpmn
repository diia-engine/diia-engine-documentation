  <bpmn:process id="feature-unregistered-role" name="Процес для перевірки автоматичного старту після автентифікації користувача з роллю UNREGISTERED" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Початок" camunda:initiator="initiator">
      <bpmn:outgoing>Flow_0vehii1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_16pp0sd" name="Завершення">
      <bpmn:incoming>Flow_0eahcld</bpmn:incoming>
